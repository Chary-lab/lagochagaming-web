# Ignorar todo por defecto
*
# Mantener archivos esenciales
!.gitignore
!CNAME
!*.html
!*.css
!*.js
!manifest.webmanifest
!robots.txt
!sitemap.xml
!_headers
!.nojekyll
!VERSION
!app/
!app/*
!ads.txt
# Permitir carpeta de imágenes
!img/
!img/*
!img/avatars/
!img/mcchary/
!img/mcchary/*
# Arte del minijuego
!img/game/
!img/game/*
!img/avatars/*
# Fuentes autoalojadas (woff2, subconjunto latin)
!fonts/
!fonts/*
# Migraciones locales de Supabase: viven en Supabase, no en este repo
supabase/
# Herramientas de validación
!scripts/
!scripts/*
# Ignorar documentación
*.md
# Changelog y llms.txt se versionan
!CHANGELOG.md
!llms.txt
# Guía y documentación estable del proyecto
!README.md
!AGENTS.md
!docs/
!docs/*.md
# Clave IndexNow: debe servirse pública en la raíz
