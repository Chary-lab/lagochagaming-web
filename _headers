# GitHub Pages ignora este archivo. Solo aplica en hosts que soportan _headers
# (Cloudflare Pages, Netlify, etc.). No asumir que la CSP esta activa en produccion.
#
# Pendiente al migrar de host:
# - Alpine 3 evalua expresiones con new Function, asi que script-src necesita
#   'unsafe-eval' o cambiar a la build CSP de Alpine. Sin eso, la UI no arranca.
# - Probar Realtime (wss://*.supabase.co), YouTube, Kick y las Edge Functions.
# - Los CDN llevan integrity (SRI) en el HTML; si se cambia una version, actualizar
#   el hash o la carga se bloquea.
# - manifest-src y worker-src cubren el manifest y el worker de hls.js (blob).
/*
 Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' https://cloud.umami.is https://cdn.jsdelivr.net https://www.youtube.com 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://cloud.umami.is https://*.supabase.co wss://*.supabase.co https://kick.com https://api.kick.com https://www.youtube.com https://player.kick.com https://7tv.io; frame-src https://player.kick.com https://kick.com https://www.youtube.com https://www.instagram.com https://www.tiktok.com; media-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; manifest-src 'self'; worker-src 'self' blob:; upgrade-insecure-requests
 Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
 X-Content-Type-Options: nosniff
 X-Frame-Options: DENY
 Referrer-Policy: strict-origin-when-cross-origin
 Permissions-Policy: camera=(), microphone=(), geolocation=()
